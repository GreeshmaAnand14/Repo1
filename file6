# Shopping Bill Calculator

def calculate_total(price, quantity):
    return price * quantity


print("----- Shopping Bill -----")

item1 = input("Enter first item: ")
price1 = float(input("Enter price: "))
quantity1 = int(input("Enter quantity: "))

item2 = input("Enter second item: ")
price2 = float(input("Enter price: "))
quantity2 = int(input("Enter quantity: "))

total1 = calculate_total(price1, quantity1)
total2 = calculate_total(price2, quantity2)

subtotal = total1 + total2

if subtotal >= 1000:
    discount = subtotal * 0.10
else:
    discount = 0

final_amount = subtotal - discount

print("\n----- Bill Summary -----")
print(item1, ":", total1)
print(item2, ":", total2)
print("Subtotal:", subtotal)
print("Discount:", discount)
print("Final Amount:", final_amount)