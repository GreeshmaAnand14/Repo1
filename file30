def factorial(n):
    result = 1

    for i in range(1, n + 1):
        result = result * i

    return result


number = int(input("Enter a number: "))

if number < 0:
    print("Factorial is not defined for negative numbers.")
elif number > 1000:
    print("Please enter a number up to 1000.")
else:
    print("Factorial =", factorial(number))