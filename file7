# Password Strength Checker

password = input("Enter your password: ")

length = len(password)

has_digit = False
has_uppercase = False

for char in password:
    if char.isdigit():
        has_digit = True

    if char.isupper():
        has_uppercase = True

print("\n----- Password Analysis -----")
print("Password length:", length)

if length < 6:
    print("Strength: Weak")
elif length >= 6 and has_digit == False:
    print("Strength: Medium")
elif length >= 6 and has_digit and has_uppercase:
    print("Strength: Strong")
else:
    print("Strength: Medium")