
import heapq

tasks = []
task_id = 1

def add_task():
    global task_id

    name = input("Enter task name: ")
    priority = int(input("Enter priority (1 = High, 2 = Medium, 3 = Low): "))

    if priority not in (1, 2, 3):
        print("Invalid priority!")
        return

    heapq.heappush(tasks, (priority, task_id, name))
    task_id += 1

    print("Task added successfully!")

def view_tasks():
    if not tasks:
        print("No pending tasks.")
        return

    print("\n--- Tasks by Priority ---")

    for priority, number, name in sorted(tasks):
        level = {1: "High", 2: "Medium", 3: "Low"}[priority]
        print(f"{number}. {name} | {level}")

def complete_task():
    if not tasks:
        print("No tasks to complete.")
        return

    priority, number, name = heapq.heappop(tasks)
    print("Completed task:", name)

while True:
    print("\n1. Add Task")
    print("2. View Tasks")
    print("3. Complete Highest Priority Task")
    print("4. Exit")

    choice = input("Enter choice: ")

    if choice == "1":
        add_task()
    elif choice == "2":
        view_tasks()
    elif choice == "3":
        complete_task()
    elif choice == "4":
        print("Task manager closed.")
        break
    else:
        print("Invalid choice!")
