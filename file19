list1 = []
list2 = []

n1 = int(input("How many numbers in first list? "))

for i in range(n1):
    number = int(input("Enter number: "))
    list1.append(number)

n2 = int(input("\nHow many numbers in second list? "))

for i in range(n2):
    number = int(input("Enter number: "))
    list2.append(number)

common = []

for number in list1:
    if number in list2 and number not in common:
        common.append(number)

print("\nFirst list:", list1)
print("Second list:", list2)
print("Common elements:", common)